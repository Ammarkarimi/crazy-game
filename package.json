{
  "name": "hyperchaos",
  "productName": "HYPERCHAOS",
  "version": "1.0.0",
  "description": "A super silly space adventure for kids (and grown-ups!). Fly your rocket, cheer up the Grumpies and collect stickers.",
  "author": "ammarkarimi",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "node tools/serve.js",
    "desktop": "electron . --windowed",
    "build:web": "node tools/build-web.js",
    "build:demo": "node tools/build-web.js --demo",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "test": "node tools/smoke-test.js",
    "marketing": "node tools/marketing.js",
    "build:site": "node tools/build-site.js",
    "build:site:demo": "node tools/build-site.js --demo"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ammarkarimi.hyperchaos",
    "productName": "HYPERCHAOS",
    "copyright": "Copyright © 2026 ammarkarimi",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "manifest.webmanifest",
      "css/**",
      "src/**",
      "assets/**",
      "electron/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    }
  }
}
