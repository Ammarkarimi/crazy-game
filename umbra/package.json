{
  "name": "umbra",
  "productName": "UMBRA",
  "version": "1.0.0",
  "description": "UMBRA: Duel of Shadows. A silhouette sword-fighting game: pick your rival, master combos, forge legendary gear.",
  "author": "ammarkarimi",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Ammarkarimi/crazy-game.git",
    "directory": "umbra"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "node tools/serve.js",
    "desktop": "electron . --windowed",
    "build:web": "node tools/build-web.js",
    "build:demo": "node tools/build-web.js --demo",
    "build:site": "node tools/build-site.js",
    "build:site:demo": "node tools/build-site.js --demo",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "test": "node tools/smoke-test.js",
    "sim": "node tools/sim.js",
    "balance": "node tools/ladder.js && node tools/classes.js",
    "marketing": "node tools/marketing.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ammarkarimi.umbra",
    "productName": "UMBRA",
    "copyright": "Copyright © 2026 ammarkarimi",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "manifest.webmanifest",
      "css/**",
      "src/**",
      "assets/**",
      "electron/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.action-games",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "publish": null
  }
}
